"""
SolidWorks COM automation script generated by CFD Agent.

This script creates a simple target body and exports SLDPRT, STEP, and
Parasolid files when run in a Windows SolidWorks COM environment.
"""

import math
import os
from pathlib import Path

GEOMETRY_TYPE = "{{ task.geometry.type }}"
PARAMETERS = {{ task.geometry.parameters }}
UNIT = "{{ task.geometry.unit }}"
OUTPUT_NATIVE = r"{{ paths.native_file }}"
OUTPUT_STEP = r"{{ paths.step_file }}"
OUTPUT_PARASOLID = r"{{ paths.parasolid_file }}"


def _meters(value):
    return value / 1000.0 if UNIT == "mm" else value


def _get_title(model):
    title = model.GetTitle
    return title if isinstance(title, str) else title()


def _new_part(sw):
    template = sw.GetUserPreferenceStringValue(8)
    if not template:
        raise RuntimeError("SolidWorks default part template was not found")
    model = sw.NewDocument(template, 0, 0, 0)
    if model is None:
        raise RuntimeError(f"SolidWorks failed to create a new part from template: {template}")
    return model


def _select_front_plane(model):
    for name in ["\u524d\u89c6\u57fa\u51c6\u9762", "Front Plane"]:
        feature = model.FeatureByName(name)
        if feature and feature.Select2(False, 0):
            return
    raise RuntimeError("Could not select the front plane")


def _create_sphere(model):
    diameter = _meters(float(PARAMETERS["diameter"]))
    radius = diameter / 2.0
    _select_front_plane(model)
    sketch = model.SketchManager
    sketch.InsertSketch(True)
    sketch.CreateCenterLine(0, -radius, 0, 0, radius, 0)
    sketch.CreateArc(0, 0, 0, 0, radius, 0, 0, -radius, 0, 1)
    feature = model.FeatureManager.FeatureRevolve2(
        True, True, False, False, False, False,
        0, 0, 2.0 * math.pi, 0,
        False, False, 0, 0, 0, 0, 0,
        True, True, True,
    )
    if feature is None:
        raise RuntimeError("SolidWorks failed to create sphere revolve feature")


def _create_cylinder(model):
    diameter = _meters(float(PARAMETERS["diameter"]))
    length = _meters(float(PARAMETERS["length"]))
    _select_front_plane(model)
    sketch = model.SketchManager
    sketch.InsertSketch(True)
    sketch.CreateCircleByRadius(0, 0, 0, diameter / 2.0)
    sketch.InsertSketch(True)
    feature = model.FeatureManager.FeatureExtrusion2(
        True, False, False, 0, 0, length, 0,
        False, False, False, False, 0, 0,
        False, False, False, False, True, True, True,
        0, 0, False,
    )
    if feature is None:
        raise RuntimeError("SolidWorks failed to create cylinder extrusion feature")


def _save(model, path):
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    result = model.SaveAs3(path, 0, 2)
    if not Path(path).exists():
        raise RuntimeError(f"SolidWorks SaveAs3 failed for {path}; result={result}")


def main():
    try:
        import win32com.client
    except ImportError as exc:
        raise RuntimeError("pywin32 is required for SolidWorks COM automation") from exc

    sw = win32com.client.Dispatch("SldWorks.Application")
    foreground = os.getenv("CFD_AGENT_FOREGROUND", "true").strip().lower() not in {"0", "false", "no", "off"}
    sw.Visible = foreground
    sw.UserControl = foreground
    if foreground:
        try:
            sw.Frame().Activate()
        except Exception:
            pass
    model = _new_part(sw)
    if GEOMETRY_TYPE == "sphere":
        _create_sphere(model)
    elif GEOMETRY_TYPE == "cylinder":
        _create_cylinder(model)
    else:
        raise RuntimeError(f"Unsupported geometry type: {GEOMETRY_TYPE}")

    _save(model, OUTPUT_NATIVE)
    _save(model, OUTPUT_STEP)
    _save(model, OUTPUT_PARASOLID)
    sw.CloseDoc(_get_title(model))


if __name__ == "__main__":
    main()
