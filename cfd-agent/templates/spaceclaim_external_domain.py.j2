"""SpaceClaim external-flow domain script generated by CFD Agent."""

import clr

clr.AddReference("System")
clr.AddReference("SpaceClaim.Api.V22")

from System.Collections.Generic import List
from System.IO import File
from SpaceClaim.Api.V22 import *
from SpaceClaim.Api.V22.Geometry import *

SOURCE_GEOMETRY = r"{{ source_geometry }}"
L = {{ length }}
ENCLOSURE_SHAPE = {{ domain_settings.enclosure_shape|repr }}
FLOW_DIRECTION = {{ domain_settings.flow_direction|repr }}
CLEARANCES = {{ domain_settings.clearances|repr }}
BOUNDARY_NAMES = {{ domain_settings.boundary_names|repr }}
DOMAIN_MIN = [0.0, 0.0, 0.0]
DOMAIN_MAX = [0.0, 0.0, 0.0]
OUTPUT_SCDOC = r"{{ paths.scdoc_file }}"
OUTPUT_PMDB = r"{{ paths.pmdb_file }}"
OUTPUT_STEP = r"{{ paths.step_file }}"
OUTPUT_STP_TMP = OUTPUT_STEP[:-5] + ".stp" if OUTPUT_STEP.lower().endswith(".step") else OUTPUT_STEP + ".stp"
SPACECLAIM_LOG = r"{{ paths.log_file }}"
SURFACE_ENCLOSURE_ONLY = {{ "True" if task.geometry.parameters.get("surface_enclosure_only", 0) else "False" }}


def _flow_axis_and_sign():
    axis = max(range(3), key=lambda index: abs(FLOW_DIRECTION[index]))
    if abs(FLOW_DIRECTION[axis]) <= 0:
        raise RuntimeError("Domain generation requires a finite non-zero flow direction")
    direction = [0.0, 0.0, 0.0]
    direction[axis] = 1.0 if FLOW_DIRECTION[axis] > 0 else -1.0
    if direction != FLOW_DIRECTION:
        raise RuntimeError("Domain generation requires axis-aligned flow direction")
    return axis, direction[axis]


FLOW_AXIS, FLOW_SIGN = _flow_axis_and_sign()


def _initialize_domain_extents():
    transverse = [index for index in range(3) if index != FLOW_AXIS]
    if FLOW_SIGN > 0:
        DOMAIN_MIN[FLOW_AXIS] = -CLEARANCES["upstream"]
        DOMAIN_MAX[FLOW_AXIS] = CLEARANCES["downstream"]
    else:
        DOMAIN_MIN[FLOW_AXIS] = -CLEARANCES["downstream"]
        DOMAIN_MAX[FLOW_AXIS] = CLEARANCES["upstream"]
    DOMAIN_MIN[transverse[0]] = -CLEARANCES["left"]
    DOMAIN_MAX[transverse[0]] = CLEARANCES["right"]
    DOMAIN_MIN[transverse[1]] = -CLEARANCES["bottom"]
    DOMAIN_MAX[transverse[1]] = CLEARANCES["top"]


_initialize_domain_extents()


def _log(message):
    File.AppendAllText(SPACECLAIM_LOG, str(message) + "\n")


def _create_group(part, name, objects):
    items = List[IDocObject]()
    for obj in objects:
        items.Add(obj)
    Group.Create(part, name, items)
    _log("named_selection:%s count=%d" % (name, len(list(objects))))


def _corner_component(corner, axis):
    return [corner.X, corner.Y, corner.Z][axis]


def _is_on_axis_plane(box, axis, value, tol):
    return abs(_corner_component(box.MinCorner, axis) - value) < tol and abs(_corner_component(box.MaxCorner, axis) - value) < tol


def _classify_box_faces(faces):
    inlet = []
    outlet = []
    farfield = []
    wall = []
    tol = max(DOMAIN_MAX[index] - DOMAIN_MIN[index] for index in range(3)) * 1e-6
    upstream_value = DOMAIN_MIN[FLOW_AXIS] if FLOW_SIGN > 0 else DOMAIN_MAX[FLOW_AXIS]
    downstream_value = DOMAIN_MAX[FLOW_AXIS] if FLOW_SIGN > 0 else DOMAIN_MIN[FLOW_AXIS]
    for face in faces:
        box = face.Shape.GetBoundingBox(Matrix.Identity, False)
        on_upstream = _is_on_axis_plane(box, FLOW_AXIS, upstream_value, tol)
        on_downstream = _is_on_axis_plane(box, FLOW_AXIS, downstream_value, tol)
        on_outer = any(
            _is_on_axis_plane(box, axis, DOMAIN_MIN[axis], tol) or _is_on_axis_plane(box, axis, DOMAIN_MAX[axis], tol)
            for axis in range(3)
        )
        if on_upstream:
            inlet.append(face)
        elif on_downstream:
            outlet.append(face)
        elif on_outer:
            farfield.append(face)
        else:
            wall.append(face)
    return inlet, outlet, farfield, wall


def _is_cylindrical_face(face):
    geometry = getattr(getattr(face, "Shape", None), "Geometry", None)
    name = type(geometry).__name__.lower() if geometry is not None else ""
    return "cylinder" in name or "cylindrical" in name


def _classify_cylinder_faces(faces):
    inlet = []
    outlet = []
    farfield = []
    wall = []
    tol = max(DOMAIN_MAX[index] - DOMAIN_MIN[index] for index in range(3)) * 1e-6
    upstream_value = DOMAIN_MIN[FLOW_AXIS] if FLOW_SIGN > 0 else DOMAIN_MAX[FLOW_AXIS]
    downstream_value = DOMAIN_MAX[FLOW_AXIS] if FLOW_SIGN > 0 else DOMAIN_MIN[FLOW_AXIS]
    for face in faces:
        box = face.Shape.GetBoundingBox(Matrix.Identity, False)
        if _is_on_axis_plane(box, FLOW_AXIS, upstream_value, tol):
            inlet.append(face)
        elif _is_on_axis_plane(box, FLOW_AXIS, downstream_value, tol):
            outlet.append(face)
        elif _is_cylindrical_face(face):
            farfield.append(face)
        else:
            wall.append(face)
    return inlet, outlet, farfield, wall


def _classify_faces(faces):
    if ENCLOSURE_SHAPE == "cylinder":
        return _classify_cylinder_faces(faces)
    return _classify_box_faces(faces)


def _validate_cylinder_named_selections(inlet, outlet, farfield, wall):
    if ENCLOSURE_SHAPE != "cylinder":
        return
    if not inlet or not outlet or not farfield or not wall:
        raise RuntimeError(
            "Cylinder domain classification failed before export: inlet/outlet caps, cylindrical farfield, and object_wall must all be identified."
        )


def _create_box_enclosure():
    result = BlockBody.Create(
        Point.Create(DOMAIN_MIN[0], DOMAIN_MIN[1], DOMAIN_MIN[2]),
        Point.Create(DOMAIN_MAX[0], DOMAIN_MAX[1], DOMAIN_MAX[2]),
    )
    body = result.CreatedBody
    body.Name = "external_enclosure"
    _log("external_domain_box=created")
    return body


def _create_cylinder_enclosure():
    if FLOW_DIRECTION[FLOW_AXIS] not in (-1.0, 1.0):
        raise RuntimeError("Cylinder domain generation requires axis-aligned flow direction")
    transverse = [index for index in range(3) if index != FLOW_AXIS]
    radius = max(CLEARANCES["left"], CLEARANCES["right"], CLEARANCES["top"], CLEARANCES["bottom"])
    start = [0.0, 0.0, 0.0]
    end = [0.0, 0.0, 0.0]
    start[FLOW_AXIS] = DOMAIN_MIN[FLOW_AXIS]
    end[FLOW_AXIS] = DOMAIN_MAX[FLOW_AXIS]
    result = CylinderBody.Create(
        Point.Create(start[0], start[1], start[2]),
        Point.Create(end[0], end[1], end[2]),
        radius,
    )
    body = result.CreatedBody
    body.Name = "external_enclosure"
    _log("external_domain_cylinder=created")
    return body


def _create_enclosure():
    if ENCLOSURE_SHAPE == "box":
        return _create_box_enclosure()
    if ENCLOSURE_SHAPE == "cylinder":
        try:
            return _create_cylinder_enclosure()
        except Exception as error:
            raise RuntimeError("SpaceClaim cylinder domain generation failed; no domain was exported: %s" % error)
    raise RuntimeError("Unsupported enclosure shape for SpaceClaim domain generation: " + str(ENCLOSURE_SHAPE))


def main():
    if not SOURCE_GEOMETRY:
        raise RuntimeError("No source geometry was provided by the geometry stage")

    opts = ImportOptions.Create()
    opts.CleanUpBodies = True
    opts.StitchSurfaces = True
    windows = Document.Open(SOURCE_GEOMETRY, opts)
    doc = windows[0].Document
    part = GetRootPart()
    imported = list(part.GetAllBodies())
    if len(imported) < 1:
        raise RuntimeError("No target body was imported from the source CAD geometry")
    _log("imported_bodies=%d" % len(imported))

    enclosure = _create_enclosure()

    if SURFACE_ENCLOSURE_ONLY:
        enclosure.Name = "fluid_domain_enclosure"
        _log("boolean_subtract=skipped surface_enclosure_only=True")
        inlet, outlet, farfield, unused_wall = _classify_faces(list(enclosure.Faces))
        wall = []
        for body in imported:
            for face in body.Faces:
                wall.append(face)
    else:
        tools = List[SpaceClaim.Api.V22.Modeler.Body]()
        for body in imported:
            tools.Add(body.Shape)
        enclosure.Shape.Subtract(tools)
        enclosure.Name = "fluid_domain"
        _log("boolean_subtract=ok tool_bodies=%d" % len(imported))
        faces = list(enclosure.Faces)
        inlet, outlet, farfield, wall = _classify_faces(faces)

    _validate_cylinder_named_selections(inlet, outlet, farfield, wall)
    _create_group(part, BOUNDARY_NAMES["inlet"], inlet)
    _create_group(part, BOUNDARY_NAMES["outlet"], outlet)
    _create_group(part, BOUNDARY_NAMES["farfield"], farfield)
    _create_group(part, BOUNDARY_NAMES["object_wall"], wall)

    part.Export(PartExportFormat.Step, OUTPUT_STP_TMP, False, None)
    if OUTPUT_STP_TMP != OUTPUT_STEP and File.Exists(OUTPUT_STP_TMP):
        File.Copy(OUTPUT_STP_TMP, OUTPUT_STEP, True)
    _log("exported_step=" + str(File.Exists(OUTPUT_STEP)))
    doc.SaveAs(OUTPUT_SCDOC)
    _log("saved_scdoc=" + str(File.Exists(OUTPUT_SCDOC)))
    _log("saved_pmdb=skipped; PMDB export is not required for the validated Fluent Meshing handoff")


main()
