"""SpaceClaim external-flow domain script generated by CFD Agent."""

import clr

clr.AddReference("System")
clr.AddReference("SpaceClaim.Api.V22")

from System.Collections.Generic import List
from System.IO import File
from SpaceClaim.Api.V22 import *
from SpaceClaim.Api.V22.Geometry import *

SOURCE_GEOMETRY = r"{{ source_geometry }}"
L = {{ length }}
X_MIN = -{{ task.domain.upstream_length_ratio }} * L
X_MAX = {{ task.domain.downstream_length_ratio }} * L
Y_MIN = -{{ task.domain.side_length_ratio }} * L
Y_MAX = {{ task.domain.side_length_ratio }} * L
Z_MIN = -{{ task.domain.side_length_ratio }} * L
Z_MAX = {{ task.domain.side_length_ratio }} * L
OUTPUT_SCDOC = r"{{ paths.scdoc_file }}"
OUTPUT_PMDB = r"{{ paths.pmdb_file }}"
OUTPUT_STEP = r"{{ paths.step_file }}"
OUTPUT_STP_TMP = OUTPUT_STEP[:-5] + ".stp" if OUTPUT_STEP.lower().endswith(".step") else OUTPUT_STEP + ".stp"
SPACECLAIM_LOG = r"{{ paths.log_file }}"


def _log(message):
    File.AppendAllText(SPACECLAIM_LOG, str(message) + "\n")


def _create_group(part, name, objects):
    items = List[IDocObject]()
    for obj in objects:
        items.Add(obj)
    Group.Create(part, name, items)
    _log("named_selection:%s count=%d" % (name, len(list(objects))))


def _classify_faces(faces):
    inlet = []
    outlet = []
    farfield = []
    wall = []
    tol = max(abs(X_MAX - X_MIN), abs(Y_MAX - Y_MIN), abs(Z_MAX - Z_MIN)) * 1e-6
    for face in faces:
        geom_name = type(face.Shape.Geometry).__name__
        box = face.Shape.GetBoundingBox(Matrix.Identity, False)
        if geom_name == "Sphere":
            wall.append(face)
        elif abs(box.MinCorner.X - X_MIN) < tol and abs(box.MaxCorner.X - X_MIN) < tol:
            inlet.append(face)
        elif abs(box.MinCorner.X - X_MAX) < tol and abs(box.MaxCorner.X - X_MAX) < tol:
            outlet.append(face)
        else:
            farfield.append(face)
    return inlet, outlet, farfield, wall


def main():
    if not SOURCE_GEOMETRY:
        raise RuntimeError("No source geometry was provided by the SolidWorks stage")

    opts = ImportOptions.Create()
    opts.CleanUpBodies = True
    opts.StitchSurfaces = True
    windows = Document.Open(SOURCE_GEOMETRY, opts)
    doc = windows[0].Document
    part = GetRootPart()
    imported = list(part.GetAllBodies())
    if len(imported) < 1:
        raise RuntimeError("No target body was imported from SolidWorks geometry")
    _log("imported_bodies=%d" % len(imported))

    enclosure_result = BlockBody.Create(
        Point.Create(X_MIN, Y_MIN, Z_MIN),
        Point.Create(X_MAX, Y_MAX, Z_MAX),
    )
    enclosure = enclosure_result.CreatedBody
    enclosure.Name = "external_enclosure"
    _log("external_domain_box=created")

    tools = List[SpaceClaim.Api.V22.Modeler.Body]()
    tools.Add(imported[0].Shape)
    enclosure.Shape.Subtract(tools)
    enclosure.Name = "fluid_domain"
    _log("boolean_subtract=ok")

    faces = list(enclosure.Faces)
    inlet, outlet, farfield, wall = _classify_faces(faces)
    _create_group(part, "velocity_inlet", inlet)
    _create_group(part, "pressure_outlet", outlet)
    _create_group(part, "farfield", farfield)
    _create_group(part, "object_wall", wall)

    part.Export(PartExportFormat.Step, OUTPUT_STP_TMP, False, None)
    if OUTPUT_STP_TMP != OUTPUT_STEP and File.Exists(OUTPUT_STP_TMP):
        File.Copy(OUTPUT_STP_TMP, OUTPUT_STEP, True)
    _log("exported_step=" + str(File.Exists(OUTPUT_STEP)))
    doc.SaveAs(OUTPUT_SCDOC)
    _log("saved_scdoc=" + str(File.Exists(OUTPUT_SCDOC)))
    _log("saved_pmdb=skipped; PMDB export is not required for the validated Fluent Meshing handoff")


main()
