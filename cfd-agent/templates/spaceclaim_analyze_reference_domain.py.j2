"""Read-only SpaceClaim V22 reference-domain analysis generated by CFD Agent."""

import clr
import json

clr.AddReference("System")
clr.AddReference("SpaceClaim.Api.V22")

from System.IO import File
from SpaceClaim.Api.V22 import *
from SpaceClaim.Api.V22.Geometry import Matrix

REFERENCE_FILE = r"{{ reference_file }}"
RESULT_FILE = r"{{ result_file }}"
MANUAL_FLOW_DIRECTION = {{ manual_flow_direction }}
STANDARD_BOUNDARY_ROLES = {
    "inlet": {"name": "velocity_inlet", "type": "velocity-inlet"},
    "outlet": {"name": "pressure_outlet", "type": "pressure-outlet"},
    "farfield": {"name": "farfield", "type": "wall"},
    "object_wall": {"name": "object_wall", "type": "wall"},
}


def _write_result(payload):
    File.WriteAllText(RESULT_FILE, json.dumps(payload, indent=2))


def _box(item):
    shape = getattr(item, "Shape", item)
    return shape.GetBoundingBox(Matrix.Identity, False)


def _bounds(items):
    boxes = [_box(item) for item in items]
    if not boxes:
        return None
    return {
        "min": [
            min(box.MinCorner.X for box in boxes),
            min(box.MinCorner.Y for box in boxes),
            min(box.MinCorner.Z for box in boxes),
        ],
        "max": [
            max(box.MaxCorner.X for box in boxes),
            max(box.MaxCorner.Y for box in boxes),
            max(box.MaxCorner.Z for box in boxes),
        ],
    }


def _size(bounds):
    return [bounds["max"][index] - bounds["min"][index] for index in range(3)]


def _center(bounds):
    return [(bounds["min"][index] + bounds["max"][index]) / 2.0 for index in range(3)]


def _bbox_volume(item):
    bounds = _bounds([item])
    size = _size(bounds)
    return max(size[0], 0) * max(size[1], 0) * max(size[2], 0)


def _raw_group_members(group):
    for attribute in ("Members", "Items"):
        members = getattr(group, attribute, None)
        if members is not None:
            return list(members)
    return []


def _face_members(group, all_faces):
    faces = []
    for member in _raw_group_members(group):
        if not hasattr(member, "Shape"):
            continue
        is_known_face = member in all_faces
        is_face_type = "face" in type(member).__name__.lower()
        if is_known_face or is_face_type:
            faces.append(member)
    return faces


def _window_groups(window):
    groups = getattr(window, "Groups", None)
    return list(window.Groups) if groups is not None else None


def _groups(window, part):
    window_groups = _window_groups(window)
    if window_groups is not None:
        return window_groups
    direct = getattr(part, "Groups", None)
    if direct is not None:
        return list(direct)
    getter = getattr(part, "GetAllGroups", None)
    return list(getter()) if getter is not None else []


def _role_for_name(name):
    lowered = str(name).strip().lower()
    if "inlet" in lowered:
        return "inlet"
    if "outlet" in lowered:
        return "outlet"
    if "farfield" in lowered or "far_field" in lowered or "far-field" in lowered:
        return "farfield"
    if "object_wall" in lowered or "objectwall" in lowered or "body_wall" in lowered:
        return "object_wall"
    return None


def _boundary_roles(groups, all_faces):
    roles = {}
    role_members = {}
    for group in groups:
        role = _role_for_name(getattr(group, "Name", ""))
        if role is None or role in roles:
            continue
        members = _face_members(group, all_faces)
        if members:
            roles[role] = {"name": str(group.Name)}
            role_members[role] = members
    return roles, role_members


def _flow_axis_and_sign(inlet_bounds, outlet_bounds):
    delta = [
        _center(outlet_bounds)[index] - _center(inlet_bounds)[index]
        for index in range(3)
    ]
    axis = max(range(3), key=lambda index: abs(delta[index]))
    if abs(delta[axis]) <= 0:
        return None, None
    return axis, 1.0 if delta[axis] > 0 else -1.0


def _direction(axis, sign):
    result = [0.0, 0.0, 0.0]
    result[axis] = sign
    return result


def _axis_direction_from_direction(direction):
    if not direction or len(direction) != 3:
        return None
    axis = max(range(3), key=lambda index: abs(direction[index]))
    if abs(direction[axis]) <= 0:
        return None
    return _direction(axis, 1.0 if direction[axis] > 0 else -1.0)


def _axis_and_sign_from_direction(direction):
    axis_direction = _axis_direction_from_direction(direction)
    if axis_direction is None:
        return None, None
    axis = max(range(3), key=lambda index: abs(axis_direction[index]))
    return axis, axis_direction[axis]


def _clearance_ratios(domain_bounds, object_bounds, axis, sign, characteristic_length):
    transverse = [index for index in range(3) if index != axis]
    upstream = (
        object_bounds["min"][axis] - domain_bounds["min"][axis]
        if sign > 0
        else domain_bounds["max"][axis] - object_bounds["max"][axis]
    )
    downstream = (
        domain_bounds["max"][axis] - object_bounds["max"][axis]
        if sign > 0
        else object_bounds["min"][axis] - domain_bounds["min"][axis]
    )
    values = {
        "upstream": upstream / characteristic_length,
        "downstream": downstream / characteristic_length,
        "left": (object_bounds["min"][transverse[0]] - domain_bounds["min"][transverse[0]]) / characteristic_length,
        "right": (domain_bounds["max"][transverse[0]] - object_bounds["max"][transverse[0]]) / characteristic_length,
        "bottom": (object_bounds["min"][transverse[1]] - domain_bounds["min"][transverse[1]]) / characteristic_length,
        "top": (domain_bounds["max"][transverse[1]] - object_bounds["max"][transverse[1]]) / characteristic_length,
    }
    return values if all(value > 0 for value in values.values()) else None


def _select_fluid_domain_body(bodies, warnings):
    ranked = sorted(bodies, key=_bbox_volume, reverse=True)
    selected = ranked[0]
    warnings.append(
        "Selected the largest bounding-box-volume body as the fluid domain from %d root bodies."
        % len(ranked)
    )
    return selected


def _face_belongs_to_body(face, body):
    if face in list(body.Faces):
        return True
    parent = getattr(face, "Parent", None)
    if parent is body:
        return True
    getter = getattr(face, "GetAncestor", None)
    if getter is not None:
        try:
            return getter(type(body)) is body
        except Exception:
            return False
    return False


def _object_wall_faces_for_domain(candidates, domain_body, domain_faces):
    valid = []
    for face in candidates:
        if face in domain_faces and _face_belongs_to_body(face, domain_body):
            valid.append(face)
    return valid


def _is_planar_face(face):
    geometry = getattr(getattr(face, "Shape", None), "Geometry", None)
    return geometry is not None and "plane" in type(geometry).__name__.lower()


def _is_cylindrical_face(face):
    geometry = getattr(getattr(face, "Shape", None), "Geometry", None)
    name = type(geometry).__name__.lower() if geometry is not None else ""
    return "cylinder" in name or "cylindrical" in name


def _is_outer_bbox_face(face, domain_bounds):
    face_bounds = _bounds([face])
    tolerance = max(_size(domain_bounds)) * 1e-7
    for axis in range(3):
        if (
            abs(face_bounds["min"][axis] - domain_bounds["min"][axis]) <= tolerance
            and abs(face_bounds["max"][axis] - domain_bounds["min"][axis]) <= tolerance
        ) or (
            abs(face_bounds["min"][axis] - domain_bounds["max"][axis]) <= tolerance
            and abs(face_bounds["max"][axis] - domain_bounds["max"][axis]) <= tolerance
        ):
            return True
    return False


def _is_planar_cap_face(face, domain_bounds, flow_axis):
    if not _is_planar_face(face):
        return False
    face_bounds = _bounds([face])
    tolerance = max(_size(domain_bounds)) * 1e-7
    return (
        abs(face_bounds["min"][flow_axis] - domain_bounds["min"][flow_axis]) <= tolerance
        and abs(face_bounds["max"][flow_axis] - domain_bounds["min"][flow_axis]) <= tolerance
    ) or (
        abs(face_bounds["min"][flow_axis] - domain_bounds["max"][flow_axis]) <= tolerance
        and abs(face_bounds["max"][flow_axis] - domain_bounds["max"][flow_axis]) <= tolerance
    )


def _detect_enclosure_shape(domain_faces, domain_bounds, flow_axis, warnings):
    outer_faces = [face for face in domain_faces if _is_outer_bbox_face(face, domain_bounds)]
    planar_outer_faces = [face for face in outer_faces if _is_planar_face(face)]
    if len(outer_faces) == 6 and len(planar_outer_faces) == 6:
        warnings.append("Detected box enclosure from exactly six planar outer boundary faces.")
        return "box"
    cylindrical_outer_faces = [face for face in domain_faces if _is_cylindrical_face(face)]
    planar_cap_faces = [face for face in domain_faces if _is_planar_cap_face(face, domain_bounds, flow_axis)]
    if len(cylindrical_outer_faces) >= 1 and len(planar_cap_faces) == 2:
        warnings.append("Detected cylinder enclosure from cylindrical outer face and two planar caps aligned with flow axis.")
        return "cylinder"
    warnings.append(
        "Could not reliably identify enclosure shape from outer faces; using box fallback."
    )
    return "box"


def _open_reference():
    options = ImportOptions.Create()
    options.CleanUpBodies = False
    options.StitchSurfaces = False
    windows = Document.Open(REFERENCE_FILE, options)
    if not windows:
        raise RuntimeError("SpaceClaim did not open or import the reference file")
    window = windows[0]
    return window, window.Document


def analyze():
    warnings = []
    window, document = _open_reference()
    part = GetRootPart()
    bodies = list(part.GetAllBodies())
    groups = _groups(window, part)
    if not bodies:
        raise RuntimeError("reference contains no root bodies")

    all_faces = []
    for body in bodies:
        all_faces.extend(list(body.Faces))
    roles, role_members = _boundary_roles(groups, all_faces)
    domain_body = _select_fluid_domain_body(bodies, warnings)
    domain_faces = list(domain_body.Faces)
    if not domain_faces:
        raise RuntimeError("selected fluid-domain body contains no faces")
    domain_bounds = _bounds([domain_body])

    object_faces = _object_wall_faces_for_domain(
        role_members.get("object_wall", []), domain_body, domain_faces
    )
    if not object_faces:
        raise RuntimeError("object_wall faces do not belong to the selected fluid-domain body")
    object_bounds = _bounds(object_faces)

    inlet_faces = role_members.get("inlet", [])
    outlet_faces = role_members.get("outlet", [])
    axis = None
    sign = None
    flow_direction = None
    if inlet_faces and outlet_faces:
        axis, sign = _flow_axis_and_sign(_bounds(inlet_faces), _bounds(outlet_faces))
        if axis is not None:
            flow_direction = _direction(axis, sign)
    if axis is None and MANUAL_FLOW_DIRECTION:
        axis, sign = _axis_and_sign_from_direction(MANUAL_FLOW_DIRECTION)
        flow_direction = _axis_direction_from_direction(MANUAL_FLOW_DIRECTION)
        warnings.append(
            "Inlet/outlet faces did not establish flow direction; used manual flow direction and standard boundary roles."
        )
        if flow_direction != MANUAL_FLOW_DIRECTION:
            warnings.append(
                "Manual flow direction was not axis-aligned; using dominant axis direction %s."
                % flow_direction
            )
        roles["inlet"] = STANDARD_BOUNDARY_ROLES["inlet"]
        roles["outlet"] = STANDARD_BOUNDARY_ROLES["outlet"]
    if axis is None:
        raise RuntimeError(
            "inlet/outlet face groups do not establish a flow direction; provide manual_flow_direction"
        )

    object_size = _size(object_bounds)
    characteristic_length = max(object_size)
    if characteristic_length <= 0:
        raise RuntimeError("object_wall bounding box has no positive characteristic length")
    ratios = _clearance_ratios(domain_bounds, object_bounds, axis, sign, characteristic_length)
    if ratios is None:
        raise RuntimeError("detected domain/object bounding boxes do not yield six positive clearances")

    if "farfield" not in roles:
        roles["farfield"] = STANDARD_BOUNDARY_ROLES["farfield"]
        warnings.append("No farfield group was detected; the standard farfield boundary will be used.")
    roles["object_wall"] = roles.get("object_wall", STANDARD_BOUNDARY_ROLES["object_wall"])
    enclosure_shape = _detect_enclosure_shape(domain_faces, domain_bounds, axis, warnings)
    return {
        "success": True,
        "reference_file": REFERENCE_FILE,
        "detection_method": "spaceclaim_v22_named_groups_and_bounding_boxes",
        "reference_characteristic_length": characteristic_length,
        "enclosure_shape": enclosure_shape,
        "flow_direction": flow_direction,
        "clearance_ratios": ratios,
        "boundary_roles": roles,
        "inspection": {
            "root_body_count": len(bodies),
            "root_group_count": len(groups),
            "selected_domain_face_count": len(domain_faces),
            "domain_bbox": domain_bounds,
            "object_wall_bbox": object_bounds,
        },
        "warnings": warnings,
    }


try:
    _write_result(analyze())
except Exception as error:
    _write_result(
        {
            "success": False,
            "reference_file": REFERENCE_FILE,
            "error": str(error),
            "warnings": [
                "Reference file was inspected read-only; no document save or export was performed.",
                "Provide named inlet, outlet, and object_wall groups with face members, or use manual settings.",
            ],
        }
    )
